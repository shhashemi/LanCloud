@model ItemListVm
@{
    ViewData["Title"] = "فایل‌های شبکه";
}

<div class="page-head">
    <div>
        <h1>@Html.Icon("globe") فایل‌های شبکه</h1>
        <p>چیزهایی که اعضا برای همه‌ی شبکه عمومی کرده‌اند.</p>
    </div>
    <div class="toolbar">
        <div class="seg" role="group" aria-label="نوع نمایش">
            <button type="button" data-view="grid" aria-label="نمایش شبکه‌ای" class="active">@Html.Icon("grid")</button>
            <button type="button" data-view="list" aria-label="نمایش لیستی">@Html.Icon("list")</button>
        </div>
    </div>
</div>

<partial name="_ItemList" model="Model" />
